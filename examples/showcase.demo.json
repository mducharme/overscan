    { "id": "chrome", "scene": "./showcase/03-chrome.scene.json", "duration": 7.85, "transition": { "type": "push", "duration": 0.35 } },
    { "id": "flower", "scene": "./showcase/04-flower.scene.json", "duration": 7.95, "transition": { "type": "checker", "duration": 0.45 } },
    { "id": "burst", "scene": "./showcase/05-burst.scene.json", "duration": 7.95, "transition": { "type": "blinds", "duration": 0.45 } },
    { "id": "jelly", "scene": "./showcase/06-jelly.scene.json", "duration": 8.4, "transition": { "type": "melt", "duration": 0.9 } },
    { "id": "planet", "scene": "./showcase/07-planet.scene.json", "duration": 15.5, "transition": { "type": "iris", "duration": 0.5 } },
