    { "id": "canyon", "scene": "./showcase/09-canyon.scene.json", "duration": 7.85, "transition": { "type": "push", "duration": 0.35 } },
    { "id": "bloom", "scene": "./showcase/10-bloom.scene.json", "duration": 7.9, "transition": { "type": "checker", "duration": 0.4 } },
    { "id": "finale", "scene": "./showcase/11-finale.scene.json", "duration": 8.5, "transition": { "type": "melt", "duration": 1.0 } },
    { "id": "credits", "scene": "./showcase/12-credits.scene.json", "duration": 7.5 }
  ]
}
