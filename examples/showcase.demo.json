{
  "id": "showcase",
  "title": "Overscan: pixels bleeding beyond the edge",
  "loop": false,
  "audio": "./showcase/music.mp3",
  "modifiers": [
    { "id": "crt", "impl": "crt", "config": { "scanlineStrength": 0.14, "vignetteStrength": 0.22, "barrelDistortion": 0.03, "phosphorGlow": 0.12 } }
  ],
  "sections": [
    { "id": "lock", "scene": "./showcase/01-lock.scene.json", "duration": 7.5 },
    { "id": "bleed", "scene": "./showcase/02-bleed.scene.json", "duration": 7.75, "transition": { "type": "flash", "duration": 0.25 } },
    { "id": "grid", "scene": "./showcase/03-grid.scene.json", "duration": 7.85, "transition": { "type": "push", "duration": 0.35 } },
    { "id": "walls", "scene": "./showcase/04-walls.scene.json", "duration": 7.95, "transition": { "type": "checker", "duration": 0.45 } },
    { "id": "flower", "scene": "./showcase/05-flower.scene.json", "duration": 7.95, "transition": { "type": "blinds", "duration": 0.45 } },
    { "id": "jelly", "scene": "./showcase/06-jelly.scene.json", "duration": 8.4, "transition": { "type": "melt", "duration": 0.9 } },
    { "id": "planet", "scene": "./showcase/07-planet.scene.json", "duration": 15.25, "transition": { "type": "flash", "duration": 0.25 } },
    { "id": "hyperspace", "scene": "./showcase/08-hyperspace.scene.json", "duration": 8.0, "transition": { "type": "zoom-out", "duration": 0.5 } },
    { "id": "monument", "scene": "./showcase/09-monument.scene.json", "duration": 7.85, "transition": { "type": "push", "duration": 0.35 } },
    { "id": "burn", "scene": "./showcase/10-burn.scene.json", "duration": 7.9, "transition": { "type": "checker", "duration": 0.4 } },
    { "id": "finale", "scene": "./showcase/11-finale.scene.json", "duration": 8.5, "transition": { "type": "melt", "duration": 1.0 } },
    { "id": "afterglow", "scene": "./showcase/12-afterglow.scene.json", "duration": 7.5 }
  ]
}
