{
  "id": "transition",
  "title": "Transition",
  "duration": 10,
  "bpm": 120,
  "rowsPerBeat": 8,
  "resolution": { "width": 640, "height": 360 },
  "fps": 30,
  "tracks": [
    {
      "name": "transition.progress",
      "keys": [
        { "row": 0, "value": 0, "interpolation": "smooth" },
        { "row": 40, "value": 1, "interpolation": "smooth" },
        { "row": 80, "value": 0, "interpolation": "smooth" }
      ]
    }
  ],
  "graph": {
    "nodes": [
      { "id": "plasma1", "type": "generator", "impl": "plasma", "config": { "speed": 0.65, "scale": 1.35 } },
      {
        "id": "curve1",
        "type": "generator",
        "impl": "lissajous",
        "config": { "a": 3, "b": 2, "delta": 1.57, "trailLength": 520, "decay": 0.94, "color": "#7dffb8", "lineWidth": 1.5, "glow": 0.45 }
      },
      {
        "id": "trans1",
        "type": "compositor",
        "impl": "transition",
        "config": {
          "mode": "iris",
          "progress": { "track": "transition.progress" },
          "easing": "smooth",
          "flashColor": "#ffffff"
        }
      }
    ],
    "edges": [
      { "from": { "node": "plasma1", "output": "color" }, "to": { "node": "trans1", "input": "base" } },
      { "from": { "node": "curve1", "output": "color" }, "to": { "node": "trans1", "input": "overlay" } }
    ],
    "outputs": { "terminal": "trans1", "browser": "trans1", "export": "trans1" }
  }
}
