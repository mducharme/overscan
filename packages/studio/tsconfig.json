{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@overscan/types": ["../../packages/types/src/index.ts"],
      "@overscan/core/browser": ["../../packages/core/src/browser.ts"],
      "@overscan/nodes/browser": ["../../packages/nodes/src/browser.ts"],
      "@overscan/sink-browser": ["../../packages/sink-browser/src/index.ts"],
      "@overscan/sink-terminal": ["../../packages/sink-terminal/src/index.ts"],
      "@overscan/terminal-renderers": ["../../packages/sink-terminal/src/renderers/index.ts"],
      "@overscan/terminal-cells": ["../../packages/sink-terminal/src/ascii-cell.ts"],
      "@overscan/sequencer": ["../../packages/sequencer/src/index.ts"]
    }
  },
  "include": ["src"]
}
