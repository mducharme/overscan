{
  "name": "@overscan/sink-browser",
  "version": "0.2.0",
  "description": "In-browser display sinks (HTML Canvas / future WebGL2+twgl). File export lives in @overscan/sink-export.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@overscan/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "*"
  }
}
